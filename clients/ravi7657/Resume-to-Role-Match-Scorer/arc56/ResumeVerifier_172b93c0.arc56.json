{
    "name": "ResumeVerifier",
    "structs": {
        "AttestationRecord": [
            {
                "name": "role_id",
                "type": "string"
            },
            {
                "name": "match_score",
                "type": "uint64"
            },
            {
                "name": "attestation_round",
                "type": "uint64"
            },
            {
                "name": "fee_paid",
                "type": "uint64"
            }
        ]
    },
    "methods": [
        {
            "name": "bootstrap",
            "args": [
                {
                    "type": "uint64",
                    "name": "min_fee",
                    "desc": "Minimum payment required to register an attestation, in \u00b5ALGO. For the MVP this is set to 500_000 (0.5 ALGO)."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [
                    "NoOp"
                ],
                "call": []
            },
            "readonly": false,
            "desc": "Initialize the contract on creation.  Must be the first call.\nCalled by deploy_config.py immediately after contract creation.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "register_attestation",
            "args": [
                {
                    "type": "byte[32]",
                    "name": "resume_hash",
                    "desc": "SHA-256 hash of the resume file (exactly 32 bytes)."
                },
                {
                    "type": "string",
                    "name": "role_id",
                    "desc": "Short identifier for the job role (e.g. \"backend-engineer\")."
                },
                {
                    "type": "uint64",
                    "name": "match_score",
                    "desc": "Deterministic match score 0\u2013100 computed by the scoring engine."
                },
                {
                    "type": "pay",
                    "name": "payment",
                    "desc": "Reference to the grouped PaymentTransaction (group index 0)."
                }
            ],
            "returns": {
                "type": "string",
                "desc": "\"ATTESTED\" on success."
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Register a resume\u2013role match attestation on-chain.\nThis method MUST be called as part of an atomic transaction group:   Group[0]: PaymentTransaction \u2192 this contract address, \u2265 min_fee \u00b5ALGO   Group[1]: ApplicationCallTransaction \u2192 this method\nThe AVM enforces atomicity: if any assertion fails, BOTH transactions in the group are rejected and the payment is not made.\nOnly the resume SHA-256 hash (not the resume content) and attestation metadata are stored on-chain.  No PII is stored.\nA second attestation for the same (applicant, resume_hash) pair will overwrite the previous record (e.g. re-attesting after a score update).",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "get_attestation",
            "args": [
                {
                    "type": "address",
                    "name": "applicant",
                    "desc": "Wallet address of the applicant who registered the attestation."
                },
                {
                    "type": "byte[32]",
                    "name": "resume_hash",
                    "desc": "SHA-256 hash of the resume file (32 bytes)."
                }
            ],
            "returns": {
                "type": "(string,uint64,uint64,uint64)",
                "struct": "AttestationRecord",
                "desc": "The AttestationRecord: role_id, match_score, attestation_round, fee_paid."
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "desc": "Retrieve the full attestation record for a given applicant and resume hash.\nCallable by anyone (employer, auditor, third party). Reverts if no attestation exists.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "verify_resume_hash",
            "args": [
                {
                    "type": "address",
                    "name": "applicant",
                    "desc": "Wallet address of the applicant."
                },
                {
                    "type": "byte[32]",
                    "name": "resume_hash",
                    "desc": "SHA-256 hash of the resume file (32 bytes)."
                }
            ],
            "returns": {
                "type": "bool",
                "desc": "True if an attestation exists, False otherwise."
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "desc": "Quick existence check: does an attestation exist for this (applicant, resume_hash)?\nDoes NOT revert \u2014 returns False if not found. Useful for a simple verified / not-verified badge in the employer UI.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "withdraw_fees",
            "args": [
                {
                    "type": "uint64",
                    "name": "amount",
                    "desc": "Amount in \u00b5ALGO to withdraw from the contract account."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Admin-only: transfer accumulated attestation fees from the contract to admin.\nSends an inner PaymentTransaction from the contract account to the admin address. Only the admin (the address set during bootstrap) may call this.",
            "events": [],
            "recommendations": {}
        }
    ],
    "arcs": [
        22,
        28
    ],
    "desc": "\n    ResumeVerifier \u2014 Resume Role Matcher on Algorand.\n\n    Contract account accumulates attestation fees (0.5 ALGO per attestation).\n    Admin (deployer) can withdraw accumulated fees via withdraw_fees().\n    ",
