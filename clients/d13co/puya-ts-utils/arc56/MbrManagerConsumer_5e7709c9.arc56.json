                ]
            },
            "readonly": true,
            "desc": "Log each account's credit balance (a big-endian uint64) in input order \u2014 an empty\nlog line means the account has no credit box (unambiguous: an existing box logs 8\nbytes even at zero balance). Readonly; meant to be simulated with allowMoreLogging\nto batch-fetch many balances in one call.",
            "events": [],
            "recommendations": {}
