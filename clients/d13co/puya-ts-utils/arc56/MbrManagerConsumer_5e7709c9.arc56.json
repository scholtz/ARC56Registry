            },
            "readonly": false,
            "desc": "Withdraw all remaining MBR credits for the sender. Deletes the credit box, so the\nMBR locked for the box itself is refunded too. The inner payment carries zero fee \u2014\ncallers must cover it with fee pooling (1000 \u00b5A extra fee).",
            "events": [],
            "recommendations": {}
        }
