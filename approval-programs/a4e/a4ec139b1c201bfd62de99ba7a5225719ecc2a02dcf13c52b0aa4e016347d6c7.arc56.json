                    "type": "byte[]",
                    "name": "task_id",
                    "desc": "Server-generated UUID for this task record (UTF-8 encoded)."
                },
                {
                    "type": "string",
                    "name": "author",
                    "desc": "Algorand address of the payer. Stored inside ``metadata_json``; validated non-empty here."
                },
                {
                    "type": "byte[]",
                    "name": "metadata_json",
                    "desc": "Full JSON-serialised ``TaskRecord``. Written verbatim to the ``tasks`` box."
                }
            ],
