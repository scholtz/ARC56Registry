    "methods": [
        {
            "name": "add_evaluation",
            "args": [
                {
                    "type": "uint64",
                    "name": "attestation_app_id",
                    "desc": "On-chain application ID of the existing ``CaptreApp`` contract. Must be listed in the transaction's ``foreign_apps`` array."
                },
                {
                    "type": "uint64",
                    "name": "task_app_id",
                    "desc": "On-chain application ID of the ``TaskApp`` contract. Must be listed in ``foreign_apps`` when ``task_hash_key`` is non-empty. Pass ``0`` only when ``task_hash_key`` is empty."
                },
                {
                    "type": "byte[]",
                    "name": "content_hash_key",
                    "desc": "32-byte SHA-256 digest key of the attestation to reference. Passed verbatim to ``CaptreApp.exists()``."
                },
                {
                    "type": "byte[]",
                    "name": "task_hash_key",
                    "desc": "32-byte SHA-256 digest key of the task to reference. Pass ``b\"\"`` (zero-length) to skip the task existence check for evaluations not linked to a specific task."
                },
                {
                    "type": "byte[]",
                    "name": "evaluation_id_key",
                    "desc": "32-byte SHA-256 digest of the evaluation UUID. Used as the ``evaluations`` box key. Must not already exist \u2014 aborts with ``ERR_ALREADY_EXISTS`` if so."
                },
                {
                    "type": "byte[]",
                    "name": "metadata_json",
                    "desc": "Full JSON-serialised ``EvaluationRecord``. Written verbatim to the ``evaluations`` box."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Write a new evaluation record, verifying the full provenance chain.\nCross-calls ``CaptreApp.exists(content_hash_key)`` unconditionally. When ``task_hash_key`` is non-empty, also cross-calls ``TaskApp.task_exists(task_hash_key)``. Both upstream apps must be listed in the transaction's ``foreign_apps`` array.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "get_evaluation",
            "args": [
                {
                    "type": "byte[]",
                    "name": "evaluation_id_key",
                    "desc": "The 32-byte SHA-256 digest key to look up."
                }
            ],
            "returns": {
                "type": "byte[]",
                "desc": "The raw JSON metadata blob stored in the box, or ``b\"\"`` if no box exists for this key."
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "desc": "Read an evaluation record by ``evaluation_id_key``.",
            "events": [],
            "recommendations": {}
        }
    ],
    "arcs": [
        22,
        28
    ],
    "desc": "\n    On-chain evaluation ledger.\n\n    Stores evaluation records that reference attestations in ``CaptreApp`` and\n    optionally tasks in ``TaskApp``. Before writing, cross-calls both upstream\n    contracts to verify the referenced records are real \u2014 proving correctness,\n    not just storage. Supports update and deletion so stranded ALGO can always\n    be recovered.\n\n    Attributes\n    ----------\n    evaluations : BoxMap[Bytes, Bytes]\n        Maps ``evaluation_id_key`` (32-byte SHA-256 digest of the evaluation\n        UUID) \u2192 serialised JSON metadata blob.\n        Box key prefix: ``b\"e:\"``. Box name is always 34 bytes.\n    ",
    "networks": {},
